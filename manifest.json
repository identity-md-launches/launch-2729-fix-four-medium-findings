{
  "manifest_version": 3,
  "name": "Squeektoshi Status",
  "short_name": "Squeektoshi",
  "version": "1.0.0",
  "description": "Is the hamster running? Live Squeekchain wheel status in your toolbar, with a ping when Squeektoshi wakes up.",
  "icons": {
    "16": "icons/idle-16.png",
    "32": "icons/idle-32.png",
    "48": "icons/idle-48.png",
    "128": "icons/idle-128.png"
  },
  "action": {
    "default_title": "Squeektoshi Status",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["alarms", "notifications", "storage"],
  "host_permissions": ["https://api.squeekchain.com/*"]
}
